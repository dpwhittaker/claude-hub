[Unit]
Description=claude remote-control — serves ~/projects to claude.ai/code and the Claude app, with Claude in Chrome
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# EDIT BEFORE INSTALLING: User= must match the account that owns ~/projects
# and is logged in to Claude Code, and the paths below must point at its home
# (systemd doesn't expand ~ here).
User=david
WorkingDirectory=/home/david/projects
# Spawned sessions run Bash with this environment, so match a hub terminal.
Environment=TERM=xterm-256color COLORTERM=truecolor
# A login shell, so every session claude.ai spawns sees the same PATH and
# profile as a terminal session. --chrome gives those sessions the Claude in
# Chrome tools (the machine's /chrome default is off). It needs no TTY; its
# status screen goes to the journal.
#
# Only one remote-control may serve a folder: stop any `claude rc` started by
# hand in ~/projects first, or this unit exits with "already served" and
# retries until it's gone.
ExecStart=/bin/bash -lc 'exec /home/david/.local/bin/claude remote-control --chrome'
# Default KillMode (control-group): a stop or restart also ends the sessions
# it spawned. Each start registers a new environment id with claude.ai.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
